// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

// ================== IERC20 Minimal ==================
interface IERC20 {
    function totalSupply() external view returns (uint256);
    function balanceOf(address account) external view returns (uint256);
    function transfer(address recipient, uint256 amount) external returns (bool);
    function allowance(address owner, address spender) external view returns (uint256);
    function approve(address spender, uint256 amount) external returns (bool);
    function transferFrom(address sender,address recipient,uint256 amount) external returns (bool);
}


// ================== SafeERC20 (inline) ==================
library SafeERC20 {
    function safeTransfer(IERC20 token, address to, uint256 value) internal {
        require(_callOptionalReturn(token, abi.encodeWithSelector(token.transfer.selector, to, value)), "SafeERC20: transfer failed");
    }

    function safeTransferFrom(IERC20 token,address from,address to,uint256 value) internal {
        require(_callOptionalReturn(token, abi.encodeWithSelector(token.transferFrom.selector, from, to, value)), "SafeERC20: transferFrom failed");
    }

    function safeApprove(IERC20 token,address spender,uint256 value) internal {
        require(_callOptionalReturn(token, abi.encodeWithSelector(token.approve.selector, spender, value)), "SafeERC20: approve failed");
    }

    function _callOptionalReturn(IERC20 token, bytes memory data) private returns (bool) {
        (bool success, bytes memory returndata) = address(token).call(data);
        if (!success) return false;
        if (returndata.length == 0) return true;
        return abi.decode(returndata, (bool));
    }
}

// ================== Ownable ==================
abstract contract Ownable {
    address private _owner;
    mapping(address => bool) internal _subOwners;
    address[] internal subOwnerList;

    address private pendingOwner;
    address private proposer;

    event OwnershipTransferred(address indexed previousOwner, address indexed newOwner);
    event SubOwnerAdded(address indexed subOwner);
    event SubOwnerRemoved(address indexed subOwner);
    event OwnerProposed(address indexed proposer, address indexed newOwner);
    event OwnerConfirmed(address indexed confirmer, address indexed newOwner);
    event PendingCleared(address indexed clearedBy);

    constructor(address initialOwner) {
        require(initialOwner != address(0), "Owner: zero address");
        _owner = initialOwner;
        emit OwnershipTransferred(address(0), initialOwner);
    }

    modifier onlyOwner() {
        require(msg.sender == _owner, "Ownable: caller is not owner");
        _;
    }

    modifier onlyOwnerOrSub() {
        require(msg.sender == _owner || _subOwners[msg.sender], "Not authorized");
        _;
    }

    function owner() public view returns (address) {
        return _owner;
    }

    // === Case 1: Owner Direct Transfer ===
    function transferOwnership(address newOwner) public onlyOwner {
        require(newOwner != address(0), "Owner: zero address");
        emit OwnershipTransferred(_owner, newOwner);
        _owner = newOwner;
    }

    // === Case 2: 2 SubOwner Approval ===
    function requestNewMainOwner(address newOwner) external {
        require(isSubOwner(msg.sender), "Only SubOwner can propose");
        require(newOwner != address(0), "Zero address");
        require(pendingOwner == address(0), "Pending owner exists");

        pendingOwner = newOwner;
        proposer = msg.sender;

        emit OwnerProposed(msg.sender, newOwner);
    }

    function confirmRequestedOwner() external {
        require(isSubOwner(msg.sender), "Only SubOwner can confirm");
        require(pendingOwner != address(0), "No pending owner");
        require(msg.sender != proposer, "Same SubOwner cannot confirm");

        address newOwner = pendingOwner;

        delete pendingOwner;
        delete proposer;

        emit OwnershipTransferred(_owner, newOwner);
        _owner = newOwner;

        emit OwnerConfirmed(msg.sender, newOwner);
    }

    // === Clear Pending Proposal ===
    function clearRequestedSubOwner() external onlyOwner {
        require(pendingOwner != address(0) || proposer != address(0), "No pending proposal");
        delete pendingOwner;
        delete proposer;
        emit PendingCleared(msg.sender);
    }

    // === SubOwner Management ===
    function addSubOwner(address subOwner) public onlyOwner {
        require(subOwner != address(0), "SubOwner: zero address");
        require(!_subOwners[subOwner], "SubOwner: already added");
        _subOwners[subOwner] = true;
        subOwnerList.push(subOwner);
        emit SubOwnerAdded(subOwner);
    }

    function removeSubOwner(address subOwner) external onlyOwner {
        require(_subOwners[subOwner], "SubOwner: not found");
        _subOwners[subOwner] = false;

        for (uint i = 0; i < subOwnerList.length; i++) {
            if (subOwnerList[i] == subOwner) {
                subOwnerList[i] = subOwnerList[subOwnerList.length - 1];
                subOwnerList.pop();
                break;
            }
        }
        emit SubOwnerRemoved(subOwner);
    }

    function isSubOwner(address addr) public view returns (bool) {
        return _subOwners[addr];
    }

    function getSubOwners() external view returns (address[] memory) {
        return subOwnerList;
    }
}

// ================== ReentrancyGuard ==================
abstract contract ReentrancyGuard {
    uint256 private _status;
    constructor() { _status = 1; }
    modifier nonReentrant() {
        require(_status != 2, "Reentrant call");
        _status = 2;
        _;
        _status = 1;
    }
}

// ================== Deposit ==================
contract Deposit is ReentrancyGuard, Ownable {
    using SafeERC20 for IERC20;

    address payable[] private fixedRecipients;
    address payable[] private extraRecipients;

    uint256 public ethPerRecipient;     
    uint256 public tokenPerRecipient;   

    bool public enableFixedRecipients;
    bool public enableExtraRecipients;
    bool public enableFixedAndExtra;

    event DepositReceived(address indexed sender, uint256 amount);
    event TokenForwarded(address indexed token, uint256 totalAmount);
    event ExtraRecipientAdded(address indexed recipient);
    event ExtraRecipientRemoved(address indexed recipient);
    event ModeConfigChanged(uint256 ethAmount, uint256 tokenAmount);
    event ForwardModeChanged(bool fixedEnabled, bool extraEnabled, bool bothEnabled);

    constructor() Ownable(msg.sender) {
        // Example initial subOwners
        address[4] memory initialSubs = [
            0xA2ca2F53Ad62cBD5C9c8Db7c1E7F9cfDb0390E3D,
            0x394f83fa712dc8C5756D8c80A9F38b5ce0933bbc,
            0x71E6C218a47Df08c948E247019446fC27b0A6565,
            0x06330AB956ab51F9a4BBbb0dca7287e2C23101EA
        ];

        for (uint i = 0; i < initialSubs.length; i++) {
            addSubOwner(initialSubs[i]);
        }
        
        // Example fixed recipients
        fixedRecipients.push(payable(0x040246947FCEFA8DB0ECFE63Ee758f4f601Fded1));
        fixedRecipients.push(payable(0xf1690feD8F4dAFB7a6bfc908676f7F0bbFa704bE));
        fixedRecipients.push(payable(0xeeb7BD5b0A781432FF4Cd4DF1FD0c2Ee74B2780c));
        fixedRecipients.push(payable(0xFF56d9a81dE0c8AF5929EE6A9d9182F236902dDE));
        fixedRecipients.push(payable(0x41d5878B3Fd82b8e46018d774E0EABad9bf4E1db));
        fixedRecipients.push(payable(0x4B703ae8942d9A6c52AE8Ae4E4D7548032595349));
        fixedRecipients.push(payable(0xe3D32023dc0973333cDf5d53d48d016bdE0b0Ef2));
        fixedRecipients.push(payable(0x6cfafa300E9D72B5fE1c0F3C9ebf454d7b52f5B7));
        fixedRecipients.push(payable(0xC52b3848C5b0934b01519dBC9A91BE414368a087));
        fixedRecipients.push(payable(0x1BFD6E800584df098c45d245d4b581613Ef4F575));

        // Default mode: enableFixedAndExtra = true
        enableFixedRecipients = false;
        enableExtraRecipients = false;
        enableFixedAndExtra = true;
    }

    // === Recipients ===
    function getFixedRecipients() external view returns (address payable[] memory) {
        return fixedRecipients;
    }

    function getExtraRecipients() external view returns (address payable[] memory) {
        return extraRecipients;
    }

    // === Forward Mode Control ===
    function onFixedRecipients() external onlyOwnerOrSub {
        enableFixedRecipients = true;
        enableExtraRecipients = false;
        enableFixedAndExtra = false;
        emit ForwardModeChanged(true, false, false);
    }

    function onExtraRecipients() external onlyOwnerOrSub {
        enableFixedRecipients = false;
        enableExtraRecipients = true;
        enableFixedAndExtra = false;
        emit ForwardModeChanged(false, true, false);
    }

    function enableAllForwardAllRecipients() external onlyOwnerOrSub {
        enableFixedRecipients = false;
        enableExtraRecipients = false;
        enableFixedAndExtra = true;
        emit ForwardModeChanged(false, false, true);
    }

    function disableAllForward() external onlyOwnerOrSub {
        enableFixedRecipients = false;
        enableExtraRecipients = false;
        enableFixedAndExtra = false;
        emit ForwardModeChanged(false, false, false);
    }

    function _getAllRecipients() internal view returns (address payable[] memory all) {
        if (enableFixedRecipients) {
            uint256 total = fixedRecipients.length;
            require(total > 0, "No fixed recipients");
            all = new address payable[](total);
            for (uint i = 0; i < total; i++) all[i] = fixedRecipients[i];
        } 
        else if (enableExtraRecipients) {
            uint256 total = extraRecipients.length;
            require(total > 0, "No extra recipients");
            all = new address payable[](total);
            for (uint i = 0; i < total; i++) all[i] = extraRecipients[i];
        } 
        else if (enableFixedAndExtra) {
            uint256 total = fixedRecipients.length + extraRecipients.length;
            require(total > 0, "No recipients");
            all = new address payable[](total);
            for (uint i = 0; i < fixedRecipients.length; i++) all[i] = fixedRecipients[i];
            for (uint i = 0; i < extraRecipients.length; i++) all[i + fixedRecipients.length] = extraRecipients[i];
        } 
        else {
            revert("Forwarding disabled: funds stay in contract");
        }
    }

    // === Mode Config ===
    function addEthAndTokenAmount(uint256 ethAmount, uint256 tokenAmount) external onlyOwnerOrSub {
        ethPerRecipient = ethAmount;     
        tokenPerRecipient = tokenAmount; 
        emit ModeConfigChanged(ethAmount, tokenAmount);
    }

    function disableEthAmount() external onlyOwnerOrSub {
        ethPerRecipient = 0;
        emit ModeConfigChanged(0, tokenPerRecipient);
    }

    function disableTokenAmount() external onlyOwnerOrSub {
        tokenPerRecipient = 0;
        emit ModeConfigChanged(ethPerRecipient, 0);
    }

    function disableEthAndTokenAmount() external onlyOwnerOrSub {
        ethPerRecipient = 0;
        tokenPerRecipient = 0;
        emit ModeConfigChanged(0, 0);
    }

    // === Info Getter ===
    function getFixedExtraConfigInfo() external view returns (uint256, uint256, bool, bool, bool) {
        return (ethPerRecipient, tokenPerRecipient, enableFixedRecipients, enableExtraRecipients, enableFixedAndExtra);
    }

    // === ETH Receive ===
    receive() external payable nonReentrant {
        if (!enableFixedRecipients && !enableExtraRecipients && !enableFixedAndExtra) {
            emit DepositReceived(msg.sender, msg.value);
            return;
        }
        _forwardETH(msg.value);
    }

    function _forwardETH(uint256 amount) internal {
        address payable[] memory allRecipients = _getAllRecipients();
        uint256 totalRecipients = allRecipients.length;

        if (ethPerRecipient > 0) {
            uint256 required = ethPerRecipient * totalRecipients;

            if (amount < required) {
                emit DepositReceived(msg.sender, amount);
                return;
            }

            for (uint i = 0; i < totalRecipients; i++) {
                (bool ok, ) = allRecipients[i].call{value: ethPerRecipient}("");
                require(ok, "ETH transfer failed");
            }
        } else {
            uint256 amountPerRecipient = amount / totalRecipients;
            uint256 remainder = amount % totalRecipients;
            for (uint i = 0; i < totalRecipients; i++) {
                uint256 sendAmt = amountPerRecipient;
                if (i == totalRecipients - 1) sendAmt += remainder;
                (bool ok, ) = allRecipients[i].call{value: sendAmt}("");
                require(ok, "ETH split failed");
            }
        }

        emit DepositReceived(msg.sender, amount);
    }

    // === Token Forward ===
    function transferTokenForward(IERC20 token) external nonReentrant onlyOwnerOrSub {
        if (!enableFixedRecipients && !enableExtraRecipients && !enableFixedAndExtra) {
            revert("Forwarding disabled: tokens stay in contract");
        }

        address payable[] memory allRecipients = _getAllRecipients();
        uint256 totalRecipients = allRecipients.length;
        require(totalRecipients > 0, "No recipients");

        uint256 balance = token.balanceOf(address(this));
        require(balance > 0, "No token to forward");

        if (tokenPerRecipient > 0) {
            uint256 required = tokenPerRecipient * totalRecipients;
            require(balance >= required, "Insufficient tokens");

            for (uint i = 0; i < totalRecipients; i++) {
                token.safeTransfer(allRecipients[i], tokenPerRecipient);
            }
        } else {
            uint256 amountPerRecipient = balance / totalRecipients;
            uint256 remainder = balance % totalRecipients;
            for (uint i = 0; i < totalRecipients; i++) {
                uint256 sendAmt = amountPerRecipient;
                if (i == totalRecipients - 1) sendAmt += remainder;
                token.safeTransfer(allRecipients[i], sendAmt);
            }
        }

        emit TokenForwarded(address(token), balance);
    }

    // === Recipient Management ===
    function addAddress(address payable newRecipient) external onlyOwnerOrSub {
        require(newRecipient != address(0), "Zero address");
        for (uint i = 0; i < extraRecipients.length; i++) {
            require(extraRecipients[i] != newRecipient, "Duplicate recipient");
        }
        extraRecipients.push(newRecipient);
        emit ExtraRecipientAdded(newRecipient);
    }

    function removeAddress(address recipient) external onlyOwnerOrSub {
        for (uint i = 0; i < extraRecipients.length; i++) {
            if (extraRecipients[i] == recipient) {
                extraRecipients[i] = extraRecipients[extraRecipients.length - 1];
                extraRecipients.pop();
                emit ExtraRecipientRemoved(recipient);
                return;
            }
        }
        revert("Recipient not found");
    }

    function addAddressList(address payable[] calldata newRecipients) external onlyOwnerOrSub {
        for (uint i = 0; i < newRecipients.length; i++) {
            require(newRecipients[i] != address(0), "Zero address");
            for (uint j = 0; j < extraRecipients.length; j++) {
                require(extraRecipients[j] != newRecipients[i], "Duplicate recipient");
            }
            extraRecipients.push(newRecipients[i]);
            emit ExtraRecipientAdded(newRecipients[i]);
        }
    }

    function removeAddressList(address[] calldata recipients) external onlyOwnerOrSub {
        for (uint r = 0; r < recipients.length; r++) {
            address target = recipients[r];
            bool removed = false;
            for (uint i = 0; i < extraRecipients.length; i++) {
                if (extraRecipients[i] == target) {
                    extraRecipients[i] = extraRecipients[extraRecipients.length - 1];
                    extraRecipients.pop();
                    emit ExtraRecipientRemoved(target);
                    removed = true;
                    break;
                }
            }
            require(removed, "Recipient not found");
        }
    }

    function removeAllExtraRecipients() external onlyOwnerOrSub {
        uint256 len = extraRecipients.length;
        require(len > 0, "No extra recipients");

        for (uint i = 0; i < len; i++) {
            emit ExtraRecipientRemoved(extraRecipients[i]);
        }

        delete extraRecipients;
    }

    // === Withdrawals ===
    function withdrawNative(address payable to) external onlyOwnerOrSub {
        require(to != address(0), "Zero address");
        uint256 balance = address(this).balance;
        require(balance > 0, "No ETH");
        (bool ok, ) = to.call{value: balance}("");
        require(ok, "Withdraw failed");
    }

    function withdrawToken(IERC20 token, address to) external onlyOwnerOrSub {
        require(to != address(0), "Zero address");
        uint256 balance = token.balanceOf(address(this));
        require(balance > 0, "No token");
        token.safeTransfer(to, balance);
    }
}

