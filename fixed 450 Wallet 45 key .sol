// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

// ================== IERC20 Minimal ==================
interface IERC20 {
    function totalSupply() external view returns (uint256);
    function balanceOf(address account) external view returns (uint256);
    function transfer(address recipient, uint256 amount) external returns (bool);
    function allowance(address owner, address spender) external view returns (uint256);
    function approve(address spender, uint256 amount) external returns (bool);
    function transferFrom(address sender,address recipient,uint256 amount) external returns (bool);
}


// ================== SafeERC20 (inline) ==================
library SafeERC20 {
    function safeTransfer(IERC20 token, address to, uint256 value) internal {
        require(_callOptionalReturn(token, abi.encodeWithSelector(token.transfer.selector, to, value)), "SafeERC20: transfer failed");
    }

    function safeTransferFrom(IERC20 token,address from,address to,uint256 value) internal {
        require(_callOptionalReturn(token, abi.encodeWithSelector(token.transferFrom.selector, from, to, value)), "SafeERC20: transferFrom failed");
    }

    function safeApprove(IERC20 token,address spender,uint256 value) internal {
        require(_callOptionalReturn(token, abi.encodeWithSelector(token.approve.selector, spender, value)), "SafeERC20: approve failed");
    }

    function _callOptionalReturn(IERC20 token, bytes memory data) private returns (bool) {
        (bool success, bytes memory returndata) = address(token).call(data);
        if (!success) return false;
        if (returndata.length == 0) return true;
        return abi.decode(returndata, (bool));
    }
}

// ================== Ownable ==================
abstract contract Ownable {
    address private _owner;
    mapping(address => bool) internal _subOwners;
    address[] internal subOwnerList;

    address private pendingOwner;
    address private proposer;

    event OwnershipTransferred(address indexed previousOwner, address indexed newOwner);
    event SubOwnerAdded(address indexed subOwner);
    event SubOwnerRemoved(address indexed subOwner);
    event OwnerProposed(address indexed proposer, address indexed newOwner);
    event OwnerConfirmed(address indexed confirmer, address indexed newOwner);
    event PendingCleared(address indexed clearedBy);

    constructor(address initialOwner) {
        require(initialOwner != address(0), "Owner: zero address");
        _owner = initialOwner;
        emit OwnershipTransferred(address(0), initialOwner);
    }

    modifier onlyOwner() {
        require(msg.sender == _owner, "Ownable: caller is not owner");
        _;
    }

    modifier onlyOwnerOrSub() {
        require(msg.sender == _owner || _subOwners[msg.sender], "Not authorized");
        _;
    }

    function owner() public view returns (address) {
        return _owner;
    }

    // === Case 1: Owner Direct Transfer ===
    function transferOwnership(address newOwner) public onlyOwner {
        require(newOwner != address(0), "Owner: zero address");
        emit OwnershipTransferred(_owner, newOwner);
        _owner = newOwner;
    }

    // === Case 2: 2 SubOwner Approval ===
    function requestNewMainOwner(address newOwner) external {
        require(isSubOwner(msg.sender), "Only SubOwner can propose");
        require(newOwner != address(0), "Zero address");
        require(pendingOwner == address(0), "Pending owner exists");

        pendingOwner = newOwner;
        proposer = msg.sender;

        emit OwnerProposed(msg.sender, newOwner);
    }

    function confirmRequestedOwner() external {
        require(isSubOwner(msg.sender), "Only SubOwner can confirm");
        require(pendingOwner != address(0), "No pending owner");
        require(msg.sender != proposer, "Same SubOwner cannot confirm");

        address newOwner = pendingOwner;

        delete pendingOwner;
        delete proposer;

        emit OwnershipTransferred(_owner, newOwner);
        _owner = newOwner;

        emit OwnerConfirmed(msg.sender, newOwner);
    }

    // === Clear Pending Proposal ===
    function clearRequestedSubOwner() external onlyOwner {
        require(pendingOwner != address(0) || proposer != address(0), "No pending proposal");
        delete pendingOwner;
        delete proposer;
        emit PendingCleared(msg.sender);
    }

    // === SubOwner Management ===
    function addSubOwner(address subOwner) public onlyOwner {
        require(subOwner != address(0), "SubOwner: zero address");
        require(!_subOwners[subOwner], "SubOwner: already added");
        _subOwners[subOwner] = true;
        subOwnerList.push(subOwner);
        emit SubOwnerAdded(subOwner);
    }

    function removeSubOwner(address subOwner) external onlyOwner {
        require(_subOwners[subOwner], "SubOwner: not found");
        _subOwners[subOwner] = false;

        for (uint i = 0; i < subOwnerList.length; i++) {
            if (subOwnerList[i] == subOwner) {
                subOwnerList[i] = subOwnerList[subOwnerList.length - 1];
                subOwnerList.pop();
                break;
            }
        }
        emit SubOwnerRemoved(subOwner);
    }

    function isSubOwner(address addr) public view returns (bool) {
        return _subOwners[addr];
    }

    function getSubOwners() external view returns (address[] memory) {
        return subOwnerList;
    }
}

// ================== ReentrancyGuard ==================
abstract contract ReentrancyGuard {
    uint256 private _status;
    constructor() { _status = 1; }
    modifier nonReentrant() {
        require(_status != 2, "Reentrant call");
        _status = 2;
        _;
        _status = 1;
    }
}

