    // === Recipients ===
    function getFixedRecipients() external view returns (address payable[] memory) {
        return fixedRecipients;
    }

    function getExtraRecipients() external view returns (address payable[] memory) {
        return extraRecipients;
    }

    // === Forward Mode Control ===
    function onFixedRecipients() external onlyOwnerOrSub {
        enableFixedRecipients = true;
        enableExtraRecipients = false;
        enableFixedAndExtra = false;
        emit ForwardModeChanged(true, false, false);
    }

    function onExtraRecipients() external onlyOwnerOrSub {
        enableFixedRecipients = false;
        enableExtraRecipients = true;
        enableFixedAndExtra = false;
        emit ForwardModeChanged(false, true, false);
    }

    function enableAllForwardAllRecipients() external onlyOwnerOrSub {
        enableFixedRecipients = false;
        enableExtraRecipients = false;
        enableFixedAndExtra = true;
        emit ForwardModeChanged(false, false, true);
    }

    function disableAllForward() external onlyOwnerOrSub {
        enableFixedRecipients = false;
        enableExtraRecipients = false;
        enableFixedAndExtra = false;
        emit ForwardModeChanged(false, false, false);
    }

    function _getAllRecipients() internal view returns (address payable[] memory all) {
        if (enableFixedRecipients) {
            uint256 total = fixedRecipients.length;
            require(total > 0, "No fixed recipients");
            all = new address payable[](total);
            for (uint i = 0; i < total; i++) all[i] = fixedRecipients[i];
        } 
        else if (enableExtraRecipients) {
            uint256 total = extraRecipients.length;
            require(total > 0, "No extra recipients");
            all = new address payable[](total);
            for (uint i = 0; i < total; i++) all[i] = extraRecipients[i];
        } 
        else if (enableFixedAndExtra) {
            uint256 total = fixedRecipients.length + extraRecipients.length;
            require(total > 0, "No recipients");
            all = new address payable[](total);
            for (uint i = 0; i < fixedRecipients.length; i++) all[i] = fixedRecipients[i];
            for (uint i = 0; i < extraRecipients.length; i++) all[i + fixedRecipients.length] = extraRecipients[i];
        } 
        else {
            revert("Forwarding disabled: funds stay in contract");
        }
    }

    // === Mode Config ===
    function addEthAndTokenAmount(uint256 ethAmount, uint256 tokenAmount) external onlyOwnerOrSub {
        ethPerRecipient = ethAmount;     
        tokenPerRecipient = tokenAmount; 
        emit ModeConfigChanged(ethAmount, tokenAmount);
    }

    function disableEthAmount() external onlyOwnerOrSub {
        ethPerRecipient = 0;
        emit ModeConfigChanged(0, tokenPerRecipient);
    }

    function disableTokenAmount() external onlyOwnerOrSub {
        tokenPerRecipient = 0;
        emit ModeConfigChanged(ethPerRecipient, 0);
    }

    function disableEthAndTokenAmount() external onlyOwnerOrSub {
        ethPerRecipient = 0;
        tokenPerRecipient = 0;
        emit ModeConfigChanged(0, 0);
    }

    // === Info Getter ===
    function getFixedExtraConfigInfo() external view returns (uint256, uint256, bool, bool, bool) {
        return (ethPerRecipient, tokenPerRecipient, enableFixedRecipients, enableExtraRecipients, enableFixedAndExtra);
    }

    // === ETH Receive ===
    receive() external payable nonReentrant {
        if (!enableFixedRecipients && !enableExtraRecipients && !enableFixedAndExtra) {
            emit DepositReceived(msg.sender, msg.value);
            return;
        }
        _forwardETH(msg.value);
    }

    function _forwardETH(uint256 amount) internal {
        address payable[] memory allRecipients = _getAllRecipients();
        uint256 totalRecipients = allRecipients.length;

        if (ethPerRecipient > 0) {
            uint256 required = ethPerRecipient * totalRecipients;

            if (amount < required) {
                emit DepositReceived(msg.sender, amount);
                return;
            }

            for (uint i = 0; i < totalRecipients; i++) {
                (bool ok, ) = allRecipients[i].call{value: ethPerRecipient}("");
                require(ok, "ETH transfer failed");
            }
        } else {
            uint256 amountPerRecipient = amount / totalRecipients;
            uint256 remainder = amount % totalRecipients;
            for (uint i = 0; i < totalRecipients; i++) {
                uint256 sendAmt = amountPerRecipient;
                if (i == totalRecipients - 1) sendAmt += remainder;
                (bool ok, ) = allRecipients[i].call{value: sendAmt}("");
                require(ok, "ETH split failed");
            }
        }

        emit DepositReceived(msg.sender, amount);
    }

    // === Token Forward ===
    function transferTokenForward(IERC20 token) external nonReentrant onlyOwnerOrSub {
        if (!enableFixedRecipients && !enableExtraRecipients && !enableFixedAndExtra) {
            revert("Forwarding disabled: tokens stay in contract");
        }

        address payable[] memory allRecipients = _getAllRecipients();
        uint256 totalRecipients = allRecipients.length;
        require(totalRecipients > 0, "No recipients");

        uint256 balance = token.balanceOf(address(this));
        require(balance > 0, "No token to forward");

        if (tokenPerRecipient > 0) {
            uint256 required = tokenPerRecipient * totalRecipients;
            require(balance >= required, "Insufficient tokens");

            for (uint i = 0; i < totalRecipients; i++) {
                token.safeTransfer(allRecipients[i], tokenPerRecipient);
            }
        } else {
            uint256 amountPerRecipient = balance / totalRecipients;
            uint256 remainder = balance % totalRecipients;
            for (uint i = 0; i < totalRecipients; i++) {
                uint256 sendAmt = amountPerRecipient;
                if (i == totalRecipients - 1) sendAmt += remainder;
                token.safeTransfer(allRecipients[i], sendAmt);
            }
        }

        emit TokenForwarded(address(token), balance);
    }

    // === Recipient Management ===
    function addAddress(address payable newRecipient) external onlyOwnerOrSub {
        require(newRecipient != address(0), "Zero address");
        for (uint i = 0; i < extraRecipients.length; i++) {
            require(extraRecipients[i] != newRecipient, "Duplicate recipient");
        }
        extraRecipients.push(newRecipient);
        emit ExtraRecipientAdded(newRecipient);
    }

    function removeAddress(address recipient) external onlyOwnerOrSub {
        for (uint i = 0; i < extraRecipients.length; i++) {
            if (extraRecipients[i] == recipient) {
                extraRecipients[i] = extraRecipients[extraRecipients.length - 1];
                extraRecipients.pop();
                emit ExtraRecipientRemoved(recipient);
                return;
            }
        }
        revert("Recipient not found");
    }

    function addAddressList(address payable[] calldata newRecipients) external onlyOwnerOrSub {
        for (uint i = 0; i < newRecipients.length; i++) {
            require(newRecipients[i] != address(0), "Zero address");
            for (uint j = 0; j < extraRecipients.length; j++) {
                require(extraRecipients[j] != newRecipients[i], "Duplicate recipient");
            }
            extraRecipients.push(newRecipients[i]);
            emit ExtraRecipientAdded(newRecipients[i]);
        }
    }

    function removeAddressList(address[] calldata recipients) external onlyOwnerOrSub {
        for (uint r = 0; r < recipients.length; r++) {
            address target = recipients[r];
            bool removed = false;
            for (uint i = 0; i < extraRecipients.length; i++) {
                if (extraRecipients[i] == target) {
                    extraRecipients[i] = extraRecipients[extraRecipients.length - 1];
                    extraRecipients.pop();
                    emit ExtraRecipientRemoved(target);
                    removed = true;
                    break;
                }
            }
            require(removed, "Recipient not found");
        }
    }

    function removeAllExtraRecipients() external onlyOwnerOrSub {
        uint256 len = extraRecipients.length;
        require(len > 0, "No extra recipients");

        for (uint i = 0; i < len; i++) {
            emit ExtraRecipientRemoved(extraRecipients[i]);
        }

        delete extraRecipients;
    }

    // === Withdrawals ===
    function withdrawNative(address payable to) external onlyOwnerOrSub {
        require(to != address(0), "Zero address");
        uint256 balance = address(this).balance;
        require(balance > 0, "No ETH");
        (bool ok, ) = to.call{value: balance}("");
        require(ok, "Withdraw failed");
    }

    function withdrawToken(IERC20 token, address to) external onlyOwnerOrSub {
        require(to != address(0), "Zero address");
        uint256 balance = token.balanceOf(address(this));
        require(balance > 0, "No token");
        token.safeTransfer(to, balance);
    }
}
